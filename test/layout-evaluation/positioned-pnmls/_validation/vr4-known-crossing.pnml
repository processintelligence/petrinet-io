<?xml version="1.0" encoding="UTF-8"?>
<pnml>
    <net id="vr4-known-crossing" type="http://www.pnml.org/version-2009/grammar/ptnet">
        <page id="top-level">
            <place id="p1">
                <graphics>
                    <position x="80" y="80" />
                    <dimension x="40" y="40" />
                </graphics>
                <name><text>P1</text></name>
            </place>
            <place id="p2">
                <graphics>
                    <position x="80" y="280" />
                    <dimension x="40" y="40" />
                </graphics>
                <name><text>P2</text></name>
            </place>
            <transition id="t1">
                <graphics>
                    <position x="280" y="280" />
                    <dimension x="40" y="40" />
                </graphics>
                <name><text>T1</text></name>
            </transition>
            <transition id="t2">
                <graphics>
                    <position x="280" y="80" />
                    <dimension x="40" y="40" />
                </graphics>
                <name><text>T2</text></name>
            </transition>
            <arc id="a1" source="p1" target="t1" />
            <arc id="a2" source="p2" target="t2" />
        </page>
    </net>
</pnml>
